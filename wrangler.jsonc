{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-inbox",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  // One address only — no extra per-version preview hostnames serving this inbox.
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-inbox",
    }
  ]
}
